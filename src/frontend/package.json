    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.1",
    "vite-plugin-environment": "^1.1.3"
  },
  "dependencies": {
    "@caffeineai/core-infrastructure": "^1.2.0",
    "@icp-sdk/auth": "^7.1.0",
    "@icp-sdk/core": "^5.3.0",
    "@tanstack/react-query": "^5.24.0",
    "clsx": "^2.1.1",
    "lucide-react": "0.511.0",
    "react": "~19.1.0",
